{
  "root": true,
  "env": {
    "node": true,
    "jest": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "semi": ["error", "never"],
    "no-trailing-spaces": "error",
    "eol-last": ["error", "always"],
    "arrow-parens": ["error", "as-needed"],
    "comma-dangle": ["error", "always-multiline"],
    "brace-style": ["error", "1tbs"],
    "quotes": ["error", "single"],
    "indent": ["error", 2]
  }
}